# PDFTwocast 环境变量配置
# 复制为 .env 并填入实际密钥

# DeepSeek API Key（用于脚本生成）
HARDCODED_DEEPSEEK_KEY=sk-your-deepseek-key

# MiniMax TTS（降级方案）
HARDCODED_MINIMAX_KEY=sk-api-your-minimax-key
HARDCODED_MINIMAX_GROUP=your-minimax-group-id

# 火山引擎播客大模型（主引擎）
HARDCODED_VOLC_APP_ID=your-volc-app-id
HARDCODED_VOLC_ACCESS_KEY=your-volc-access-key
HARDCODED_VOLC_APP_KEY=your-volc-app-key
